---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    {% if site.title %}
    <title>{{ site.title | xml_escape }}</title>
    {% endif %}
    {% if site.rss-description %}
    <description>{{ site.rss-description | xml_escape }}</description>
    {% endif %}
    <link>{{ '/' | absolute_url }}</link>
    <atom:link href="{{ 'feed.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    {% for release in site.data.releases limit:20 %}
      <item>
        <title>v{{ release.version }} · {{ release.title | xml_escape }}</title>
        <description>{{ release.changes | join: " " | xml_escape }}</description>
        <pubDate>{{ release.date | date_to_rfc822 }}</pubDate>
        <link>{{ '/changelog/' | absolute_url }}#v{{ release.version | replace: '.', '-' }}</link>
        <guid isPermaLink="true">{{ '/changelog/' | absolute_url }}#v{{ release.version | replace: '.', '-' }}</guid>
      </item>
    {% endfor %}
  </channel>
</rss>
