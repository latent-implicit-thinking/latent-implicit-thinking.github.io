{%- assign author_names = include.paper.authors | split: ', ' -%}
{%- assign scholarly_arxiv_id = include.paper | lit_arxiv_id -%}
{%- assign scholarly_publication = site.data.publications[include.paper.id] -%}
{
  "@type": "ScholarlyArticle",
  "@id": {{ include.paper.paper_url | jsonify }},
  "name": {{ include.paper.title | jsonify }},
  "url": {{ include.paper.paper_url | jsonify }},
  "identifier": {"@type": "PropertyValue", "propertyID": {% if scholarly_arxiv_id %}"arXiv", "value": {{ scholarly_arxiv_id | jsonify }}{% else %}"DOI", "value": {{ scholarly_publication.doi | jsonify }}{% endif %}},
  "author": [{% for name in author_names %}{"@type": "Person", "name": {{ name | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "description": {{ include.paper.summary | default: include.paper.connection | jsonify }}{% if include.paper.related_terms %},
  "keywords": {{ include.paper.related_terms | jsonify }}{% endif %}
}
