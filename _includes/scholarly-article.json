{%- assign author_names = include.paper.authors | split: ', ' -%}
{%- assign scholarly_arxiv_id = include.paper | lit_arxiv_id -%}
{
  "@type": "ScholarlyArticle",
  "@id": {{ include.paper.paper_url | jsonify }},
  "name": {{ include.paper.title | jsonify }},
  "url": {{ include.paper.paper_url | jsonify }},
  "identifier": {"@type": "PropertyValue", "propertyID": {% if scholarly_arxiv_id %}"arXiv", "value": {{ scholarly_arxiv_id | jsonify }}{% elsif include.paper.source_type == 'web-publication' %}"URL", "value": {{ include.paper.paper_url | jsonify }}{% else %}"DOI", "value": {{ include.paper.doi | jsonify }}{% endif %}},
  {% if include.paper.source_type == 'web-publication' %}"datePublished": {{ include.paper.citation_date | default: include.paper.first_public | jsonify }},
  "isPartOf": {"@type": "CreativeWork", "name": {{ include.paper.venue | jsonify }}},
  {% endif %}
  "author": [{% for name in author_names %}{"@type": {% if include.paper.organization_authors contains name %}"Organization"{% else %}"Person"{% endif %}, "name": {{ name | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "description": {{ include.paper.summary | default: include.paper.connection | jsonify }}{% if include.paper.related_terms %},
  "keywords": {{ include.paper.related_terms | jsonify }}{% endif %}
}
