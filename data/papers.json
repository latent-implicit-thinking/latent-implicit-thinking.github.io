---
layout: null
permalink: /data/papers.json
---
{
  "metadata": {
    "name": {{ site.data.meta.name | jsonify }},
    "version": {{ site.data.meta.version | jsonify }},
    "updated_at": {{ site.data.meta.updated_at | jsonify }},
    "search_refreshed_at": {{ site.data.meta.search_refreshed_at | jsonify }},
    "latest_included_first_public": {{ site.data.meta.latest_included_first_public | jsonify }},
    "core_record_count": {{ site.data.papers | size }},
    "precursor_record_count": {{ site.data.precursors | size }},
    "scope_url": {{ '/topics/' | absolute_url | jsonify }},
    "contribute_url": {{ '/contribute/' | absolute_url | jsonify }},
    "schema_url": {{ '/data/schema.json' | absolute_url | jsonify }},
    "ontology_url": {{ '/data/ontology.json' | absolute_url | jsonify }},
    "repository_url": {{ site.data.meta.repository_url | jsonify }},
    "citation_url": {{ '/data/#citation' | absolute_url | jsonify }},
    "csl_url": {{ '/data/papers.csl.json' | absolute_url | jsonify }},
    "reading_list_url": {{ '/data/reading-list.md' | absolute_url | jsonify }},
    "recent_additions_url": {{ '/recent/' | absolute_url | jsonify }},
    "addition_tracking_started_at": {{ site.data.meta.addition_tracking_started_at | jsonify }},
    "citation_policy": "Citation exports describe each entry's linked source: arXiv preprints using initial submission dates, or publications for entries without an arXiv version. Source URLs are not version-pinned. citation_date is the linked source's date; first_public orders the earliest dated public version and can refer to an earlier conference presentation.",
    "license_name": {{ site.data.meta.license_name | jsonify }},
    "license_url": {{ site.data.meta.license_url | jsonify }},
    "license_scope": "Original taxonomy, normalized curation metadata, summaries, and editorial material; third-party works remain under their own terms.",
    "record_url_prefix": {{ '/papers/' | absolute_url | jsonify }},
    "record_id_transform": "Append the unchanged record ID and a trailing slash to record_url_prefix. legacy_record_url preserves the earlier full-list anchor.",
    "provenance_note": "Many papers were found through Awesome-Latent-CoT. Entries were checked against the original papers."
  },
  "papers": [{% for paper in site.data.papers %}{% include paper-record.json paper=paper prefix="paper-" %}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "precursors": [{% for paper in site.data.precursors %}{% include paper-record.json paper=paper prefix="precursor-" %}{% unless forloop.last %},{% endunless %}{% endfor %}]
}
